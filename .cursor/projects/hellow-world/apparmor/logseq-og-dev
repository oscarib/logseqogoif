# Allows the Logseq OG development Electron binary to create user namespaces,
# so Chromium can use its normal sandbox. Same approach as Ubuntu's own
# profiles for VS Code / Chrome. This profile does NOT restrict the app.

abi <abi/5.0>,
include <tunables/global>

profile logseq-og-dev /home/oscar/Documents/logseqogoif/static/node_modules/electron/dist/electron flags=(unconfined) {
  userns,
  @{exec_path} mr,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/logseq-og-dev>
}
